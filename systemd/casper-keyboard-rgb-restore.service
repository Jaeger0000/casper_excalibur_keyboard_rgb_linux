[Unit]
Description=Casper Keyboard RGB – restore last colour on boot
# The LED device only appears once casper-wmi is loaded, which
# modules-load.d does in systemd-modules-load.service.  Ordering after
# multi-user.target (the target this unit is also wanted by) pushed the
# restore to the very end of boot for no reason.
After=systemd-modules-load.service
ConditionPathExists=/sys/class/leds/casper::kbd_backlight/led_control

[Service]
Type=oneshot
# Runs as root so it can write to sysfs directly (no pkexec needed)
ExecStart=/usr/bin/casper-keyboard-rgb --restore
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/class/leds/
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
