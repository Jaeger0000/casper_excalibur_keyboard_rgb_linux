# Give members of the "video" group write access to the Casper keyboard LED
# control file, so colour changes need no root/pkexec round trip.
#
# ACTION is matched explicitly: without it these commands also ran on
# "remove" events, spawning two processes for a file that is going away.
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="casper::kbd_backlight", \
    RUN+="/bin/sh -c 'chgrp video /sys/class/leds/casper::kbd_backlight/led_control && chmod 0660 /sys/class/leds/casper::kbd_backlight/led_control'"
